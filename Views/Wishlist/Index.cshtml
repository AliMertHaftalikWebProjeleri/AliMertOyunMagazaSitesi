@model IEnumerable<WishlistItem>

@{
    ViewData["Title"] = "İstek Listem";
}

<div class="mt-4 mb-4">
    <h2 class="text-danger border-bottom border-danger pb-2"><i class="bi bi-heart-fill"></i> İstek Listem</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info bg-dark text-info border-info">
        <i class="bi bi-info-circle-fill"></i> İstek listeniz şu an boş. 
        <a asp-controller="Catalog" asp-action="Index" class="alert-link">Katalogdan hemen oyun ekleyin!</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var item in Model)
        {
            var game = item.Game;
            <div class="col">
                <div class="card h-100 flex-row overflow-hidden shadow-sm">
                    <img src="@game.ImageUrl" alt="@game.Title" style="width: 150px; object-fit: cover;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title text-light mb-1">@game.Title</h5>
                            <span class="badge bg-secondary mb-2">@game.Category?.Name</span>
                            <p class="text-success fw-bold">@game.Price.ToString("C")</p>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">Eklenme: @item.AddedAt.ToShortDateString()</small>
                            <form asp-controller="Wishlist" asp-action="Remove" method="post">
                                <input type="hidden" name="wishlistId" value="@item.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i> Kaldır
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
