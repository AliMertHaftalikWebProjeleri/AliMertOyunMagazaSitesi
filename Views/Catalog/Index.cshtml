@model IEnumerable<Game>

@{
    ViewData["Title"] = "Oyun Kataloğu";
    var selectedCategory = ViewBag.SelectedCategory as Category;
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="text-primary mb-0">
        <i class="bi bi-controller"></i> 
        @(selectedCategory != null ? $"{selectedCategory.Name} Oyunları" : "Tüm Oyunlar")
    </h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning bg-warning text-dark border-0">
        <i class="bi bi-exclamation-triangle-fill"></i> Bu kategoride henüz oyun bulunmuyor.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var game in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <img src="@game.ImageUrl" class="card-img-top" alt="@game.Title" style="height: 220px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@game.Title</h5>
                        <p class="card-text text-muted small mb-2">
                            <span class="badge bg-secondary">@(game.Category?.Name)</span>
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <span class="fw-bold text-success">@game.Price.ToString("C")</span>
                            <form asp-controller="Wishlist" asp-action="Add" method="post">
                                <input type="hidden" name="gameId" value="@game.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-heart"></i> Ekle
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
