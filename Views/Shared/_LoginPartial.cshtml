@using Microsoft.AspNetCore.Identity
@using AliMertOyunMagaza.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item me-2">
        <a class="nav-link text-light btn btn-danger d-flex align-items-center rounded-pill px-3" asp-controller="Wishlist" asp-action="Index">
            <i class="bi bi-heart-fill me-1"></i> İstek Listem
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Manage/Index" title="Hesabım">Profilim (@User.Identity?.Name)</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-light">Çıkış Yap</button>
        </form>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="nav-link btn btn-primary text-white rounded-pill px-4 fw-bold" asp-area="Identity" asp-page="/Account/Register">Kayıt Ol</a>
    </li>
    <li class="nav-item">
        <a class="nav-link btn btn-outline-light rounded-pill px-4" asp-area="Identity" asp-page="/Account/Login">Giriş Yap</a>
    </li>
}
</ul>
