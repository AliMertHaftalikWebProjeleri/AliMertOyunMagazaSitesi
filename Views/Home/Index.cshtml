@model IEnumerable<Game>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mb-5 mt-4">
    <h1 class="display-4 fw-bold text-white mb-3">Oyun Mağazamıza Hoş Geldiniz</h1>
    <p class="lead text-light">En popüler ve en yeni oyunları keşfedin, istek listenize ekleyin.</p>
</div>

<h2 class="mb-4 text-primary border-bottom border-secondary pb-2"><i class="bi bi-star-fill"></i> Öne Çıkan Oyunlar</h2>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var game in Model)
    {
        <div class="col">
            <div class="card h-100 bg-dark text-white border-secondary">
                <img src="@game.ImageUrl" class="card-img-top" alt="@game.Title" style="height: 250px; object-fit: cover; object-position: top;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@game.Title</h5>
                    <p class="card-text text-muted mb-2">
                        <span class="badge bg-secondary">@(game.Category?.Name ?? "Kategorisiz")</span>
                    </p>
                    <p class="card-text flex-grow-1">@game.Description</p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fs-5 fw-bold text-success">@game.Price.ToString("C")</span>
                        <form asp-controller="Wishlist" asp-action="Add" method="post">
                            <input type="hidden" name="gameId" value="@game.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-heart"></i> İstek Listesine Ekle
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
